# --- LLM providers ---
# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=
# Only needed if your OpenAI-compatible server (vLLM etc.) requires a key
OLLAMA_API_KEY=

# --- Security ---
# Fernet key for the encrypted vault. Generate with: uv run jobpilot keygen
JOBPILOT_MASTER_KEY=
# Bearer token for the REST API. Generate with: uv run jobpilot keygen --token
JOBPILOT_API_TOKEN=

# --- Storage ---
# Empty = SQLite under ./data. Production: postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL=

# --- Observability (Langfuse cloud or self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Mail (Phase 4) ---------------------------------------------------------------------------
# Gmail: Google Cloud console → OAuth client of type "Desktop app"; enable the Gmail API (and the
# Calendar API for free/busy). Scopes requested: gmail.readonly, gmail.send (+ calendar.freebusy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365: Entra app registration, platform "Mobile and desktop applications",
# redirect URI http://127.0.0.1:8765/api/v1/mail/oauth/callback. Delegated permissions:
# Mail.Read, Mail.Send, User.Read, offline_access (+ Calendars.Read).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- Notifications (optional) -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
JOBPILOT_NOTIFY_WEBHOOK_URL=
